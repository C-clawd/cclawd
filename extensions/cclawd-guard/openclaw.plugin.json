{
  "id": "cclawd-guard",
  "name": "CClawd Guard",
  "description": "Security guard for CClawd agents - CClawd Guard protection with AI Security Gateway",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean",
        "description": "Enable CClawd Guard protection"
      },
      "blockOnRisk": {
        "type": "boolean",
        "description": "Deprecated: use riskPolicy. When true and riskPolicy is unset, blocks on risk."
      },
      "riskPolicy": {
        "type": "string",
        "enum": ["block", "approve", "allow"],
        "description": "block=deny risky tools; approve=ask operator via /approve; allow=log only"
      },
      "apiKey": {
        "type": "string",
        "description": "CClawd Guard API key"
      },
      "timeoutMs": {
        "type": "number",
        "description": "Detection timeout in milliseconds"
      },
      "agentName": {
        "type": "string",
        "description": "Agent name for registration"
      },
      "coreUrl": {
        "type": "string",
        "description": "CClawd Guard Core URL"
      },
      "dashboardUrl": {
        "type": "string",
        "description": "Dashboard URL"
      }
    }
  },
  "uiHints": {
    "enabled": {
      "label": "Enable Protection",
      "help": "Turn on real-time security monitoring"
    },
    "blockOnRisk": {
      "label": "Block on Risk",
      "help": "Deprecated — prefer riskPolicy"
    },
    "riskPolicy": {
      "label": "Risk policy",
      "help": "block, approve (human /approve), or allow (monitor only)"
    }
  }
}
